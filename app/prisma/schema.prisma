generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  role      Role     @default(ADMIN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  ADMIN
  VIEWER
}

// Source tag on each row: "google-sheets" or "manual"
enum DataSource {
  GOOGLE_SHEETS
  MANUAL
}

// Represents a row from the "Ticket Data" sheet (financial/sales view — Google Sheets)
model TicketData {
  id          String     @id @default(cuid())
  importBatch String
  source      DataSource @default(GOOGLE_SHEETS)

  event       String
  eventDate   DateTime?
  venue       String?
  section     String?
  row         String?
  seats       String?
  quantity    Int        @default(1)
  qtyUnsold   Int        @default(0)

  totalCost   Float      @default(0)
  income      Float      @default(0)
  profit      Float      @default(0)

  platform    String?
  account     String?
  status      String?
  paidOut     Boolean    @default(false)

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([importBatch])
  @@index([source])
  @@index([platform])
  @@index([status])
  @@index([event])
}

// Represents a row from the "Expenses" sheet
model Expense {
  id          String     @id @default(cuid())
  importBatch String
  source      DataSource @default(GOOGLE_SHEETS)

  date        DateTime?
  description String?
  category    String?
  amount      Float      @default(0)

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([importBatch])
  @@index([source])
}

// Tracks every manual Excel upload (financial/sales sheet)
model ImportBatch {
  id           String       @id @default(cuid())
  filename     String
  uploadedAt   DateTime     @default(now())
  rowsTickets  Int          @default(0)
  rowsExpenses Int          @default(0)
  status       ImportStatus @default(COMPLETED)
}

enum ImportStatus {
  PENDING
  COMPLETED
  FAILED
}

// Tracks every Google Sheets sync
model SyncLog {
  id               String     @id @default(cuid())
  startedAt        DateTime   @default(now())
  completedAt      DateTime?
  status           SyncStatus @default(RUNNING)
  rowsTickets      Int        @default(0)
  rowsExpenses     Int        @default(0)
  triggeredBy      String     @default("manual")
  error            String?
  payoutSnapshot   String?
  summarySnapshot  String?
}

enum SyncStatus {
  RUNNING
  COMPLETED
  FAILED
}

// Maps a Ticketmaster event URL to a human-readable event name
model StatsEventName {
  id        String   @id @default(cuid())
  eventUrl  String   @unique
  eventName String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Purchase ingestion (tickets BOUGHT by the reseller) ─────────────────────

enum PurchaseStatus {
  CONFIRMED
  PENDING
  CANCELLED
  REFUNDED
}

enum PurchaseSource {
  MANUAL
  EMAIL
  EXCEL
}

enum ParseStatus {
  OK
  PARTIAL  // parsed but some fields are missing/uncertain
  FAILED   // parsing failed; purchase saved with minimal data
}

enum FetchStatus {
  RUNNING
  COMPLETED
  FAILED
}

// Stores IMAP credentials for each email account used to buy tickets
model EmailAccount {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  label       String
  email       String   @unique
  password    String   // AES-256-GCM encrypted
  imapHost    String
  imapPort    Int      @default(993)
  tls         Boolean  @default(true)

  lastFetched DateTime?

  purchases Purchase[]
  fetchLogs EmailFetchLog[]
}

// Log of every IMAP fetch run per account
model EmailFetchLog {
  id              String       @id @default(cuid())
  startedAt       DateTime     @default(now())
  completedAt     DateTime?
  status          FetchStatus  @default(RUNNING)
  emailAccountId  String
  emailAccount    EmailAccount @relation(fields: [emailAccountId], references: [id], onDelete: Cascade)
  emailsScanned   Int          @default(0)
  purchasesAdded  Int          @default(0)
  error           String?
}

// Tracks every Excel purchase-history import run
model ExcelImportRun {
  id             String    @id @default(cuid())
  createdAt      DateTime  @default(now())
  filename       String
  sheetName      String    @default("Ticket Data")
  status         FetchStatus @default(RUNNING)
  totalRows      Int       @default(0)
  importedRows   Int       @default(0)
  skippedRows    Int       @default(0)
  failedRows     Int       @default(0)
  // JSON arrays for per-row details
  skippedDetails String?   // [{rowIndex, reason, fingerprint?}]
  failedDetails  String?   // [{rowIndex, error}]
  error          String?   // top-level failure message

  purchases      Purchase[]
}

// One record per ticket purchase (from email, Excel, or manual entry)
model Purchase {
  id          String         @id @default(cuid())
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  // ── Source ──────────────────────────────────────────────────────────────────
  source      PurchaseSource @default(MANUAL)
  provider    String?        // "ticketmaster"

  // ── Event ───────────────────────────────────────────────────────────────────
  eventName   String
  eventDate   DateTime?
  venue       String?

  // ── Purchase info ────────────────────────────────────────────────────────────
  purchaseDate  DateTime?    // when the ticket was bought
  account       String?      // email/account used to make the purchase
  ticketType    String?      // e.g. "Standard", "VIP", "Standing"

  // ── Seats ───────────────────────────────────────────────────────────────────
  quantity    Int            @default(1)
  section     String?
  row         String?
  seat        String?        // single seat or legacy combined string
  seatFrom    String?        // explicit range start
  seatTo      String?        // explicit range end

  // ── Financials ───────────────────────────────────────────────────────────────
  pricePaid     Float        @default(0)
  costPerTicket Float?
  currency      String       @default("GBP")

  // ── Status & dedup ──────────────────────────────────────────────────────────
  status        PurchaseStatus @default(CONFIRMED)
  parseStatus   ParseStatus    @default(OK)
  parseError    String?
  fingerprint   String?        @unique  // SHA-256 of normalised key fields

  // ── Order reference ──────────────────────────────────────────────────────────
  orderNumber String?
  platform    String?      // e.g. "ticketmaster.co.uk"

  // ── Email source metadata ────────────────────────────────────────────────────
  rawEmailId      String?   @unique  // "<account>:<imap-uid>"
  emailMessageId  String?
  emailSubject    String?
  emailSender     String?
  emailReceivedAt DateTime?

  // ── Relations ─────────────────────────────────────────────────────────────────
  emailAccountId  String?
  emailAccount    EmailAccount?   @relation(fields: [emailAccountId], references: [id], onDelete: SetNull)
  importRunId     String?
  importRun       ExcelImportRun? @relation(fields: [importRunId], references: [id], onDelete: SetNull)

  @@index([eventDate])
  @@index([source])
  @@index([status])
  @@index([platform])
  @@index([parseStatus])
  @@index([importRunId])
  @@index([emailAccountId])
}
