generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  role      Role     @default(ADMIN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  ADMIN
  VIEWER
}

// Source tag on each row: "google-sheets" or "manual"
enum DataSource {
  GOOGLE_SHEETS
  MANUAL
}

// Represents a row from the "Ticket Data" sheet
model TicketData {
  id          String     @id @default(cuid())
  importBatch String
  source      DataSource @default(GOOGLE_SHEETS)

  event       String
  eventDate   DateTime?
  venue       String?
  section     String?
  row         String?
  seats       String?
  quantity    Int        @default(1)

  // Financial columns
  totalCost   Float      @default(0) // "Total Cost" — purchase spend
  income      Float      @default(0) // "Income"     — sale revenue
  profit      Float      @default(0) // "Profit"     — income minus cost

  // Platform / account info
  platform    String?
  account     String?
  status      String?    // Sold | Listed | Pending | Cancelled
  paidOut     Boolean    @default(false)

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([importBatch])
  @@index([source])
  @@index([platform])
  @@index([status])
  @@index([event])
}

// Represents a row from the "Expenses" sheet
model Expense {
  id          String     @id @default(cuid())
  importBatch String
  source      DataSource @default(GOOGLE_SHEETS)

  date        DateTime?
  description String?
  category    String?
  amount      Float      @default(0) // "Amount"

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([importBatch])
  @@index([source])
}

// Tracks every manual Excel upload
model ImportBatch {
  id           String       @id @default(cuid())
  filename     String
  uploadedAt   DateTime     @default(now())
  rowsTickets  Int          @default(0)
  rowsExpenses Int          @default(0)
  status       ImportStatus @default(COMPLETED)
}

enum ImportStatus {
  PENDING
  COMPLETED
  FAILED
}

// Tracks every Google Sheets sync
model SyncLog {
  id           String     @id @default(cuid())
  startedAt    DateTime   @default(now())
  completedAt  DateTime?
  status       SyncStatus @default(RUNNING)
  rowsTickets  Int        @default(0)
  rowsExpenses Int        @default(0)
  triggeredBy      String     @default("manual") // "manual" | "cron"
  error            String?
  payoutSnapshot   String?    // JSON: PayoutEntry[] read from Financial Summary sheet
  summarySnapshot  String?    // JSON: FinancialSummaryKPIs read from Financial Summary sheet
}

enum SyncStatus {
  RUNNING
  COMPLETED
  FAILED
}
