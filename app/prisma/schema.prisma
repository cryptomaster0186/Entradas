generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  role      Role     @default(ADMIN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  ADMIN
  VIEWER
}

// Source tag on each row: "google-sheets" or "manual"
enum DataSource {
  GOOGLE_SHEETS
  MANUAL
}

// Represents a row from the "Ticket Data" sheet
model TicketData {
  id          String     @id @default(cuid())
  importBatch String
  source      DataSource @default(GOOGLE_SHEETS)

  event       String
  eventDate   DateTime?
  venue       String?
  section     String?
  row         String?
  seats       String?
  quantity    Int        @default(1)
  qtyUnsold   Int        @default(0) // "Qty Unsold" column from Ticket Data sheet

  // Financial columns
  totalCost   Float      @default(0) // "Total Cost" — purchase spend
  income      Float      @default(0) // "Income"     — sale revenue
  profit      Float      @default(0) // "Profit"     — income minus cost

  // Platform / account info
  platform    String?
  account     String?
  status      String?    // Sold | Listed | Pending | Cancelled
  paidOut     Boolean    @default(false)

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([importBatch])
  @@index([source])
  @@index([platform])
  @@index([status])
  @@index([event])
}

// Represents a row from the "Expenses" sheet
model Expense {
  id          String     @id @default(cuid())
  importBatch String
  source      DataSource @default(GOOGLE_SHEETS)

  date        DateTime?
  description String?
  category    String?
  amount      Float      @default(0) // "Amount"

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([importBatch])
  @@index([source])
}

// Tracks every manual Excel upload
model ImportBatch {
  id           String       @id @default(cuid())
  filename     String
  uploadedAt   DateTime     @default(now())
  rowsTickets  Int          @default(0)
  rowsExpenses Int          @default(0)
  status       ImportStatus @default(COMPLETED)
}

enum ImportStatus {
  PENDING
  COMPLETED
  FAILED
}

// Tracks every Google Sheets sync
model SyncLog {
  id           String     @id @default(cuid())
  startedAt    DateTime   @default(now())
  completedAt  DateTime?
  status       SyncStatus @default(RUNNING)
  rowsTickets  Int        @default(0)
  rowsExpenses Int        @default(0)
  triggeredBy      String     @default("manual") // "manual" | "cron"
  error            String?
  payoutSnapshot   String?    // JSON: PayoutEntry[] read from Financial Summary sheet
  summarySnapshot  String?    // JSON: FinancialSummaryKPIs read from Financial Summary sheet
}

enum SyncStatus {
  RUNNING
  COMPLETED
  FAILED
}

// Maps a Ticketmaster event URL to a human-readable event name
model StatsEventName {
  id        String   @id @default(cuid())
  eventUrl  String   @unique
  eventName String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Purchases (tickets bought by the reseller) ───────────────────────────────

enum PurchaseStatus {
  CONFIRMED
  PENDING
  CANCELLED
  REFUNDED
}

enum PurchaseSource {
  MANUAL
  EMAIL
}

enum FetchStatus {
  RUNNING
  COMPLETED
  FAILED
}

// Stores IMAP credentials for each email account used to buy tickets
model EmailAccount {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  label       String   // friendly name, e.g. "Main iCloud"
  email       String   @unique
  password    String   // AES-256-GCM encrypted — never stored in plain text
  imapHost    String
  imapPort    Int      @default(993)
  tls         Boolean  @default(true)

  lastFetched DateTime?

  purchases Purchase[]
  fetchLogs EmailFetchLog[]
}

// Log of every IMAP fetch run
model EmailFetchLog {
  id             String      @id @default(cuid())
  startedAt      DateTime    @default(now())
  completedAt    DateTime?
  status         FetchStatus @default(RUNNING)
  emailAccountId String
  emailAccount   EmailAccount @relation(fields: [emailAccountId], references: [id], onDelete: Cascade)
  emailsScanned  Int         @default(0)
  purchasesAdded Int         @default(0)
  error          String?
}

// One record per ticket purchase extracted from a confirmation email (or added manually)
model Purchase {
  id          String         @id @default(cuid())
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  // Event details
  eventName   String
  eventDate   DateTime?
  venue       String?

  // Ticket details
  section     String?
  row         String?
  seats       String?
  quantity    Int            @default(1)

  // Order details
  orderNumber String?
  platform    String         // e.g. "ticketmaster.co.uk"
  account     String         // email address used for the purchase
  pricePaid   Float          @default(0)
  currency    String         @default("GBP")

  status      PurchaseStatus @default(CONFIRMED)
  source      PurchaseSource @default(MANUAL)

  // Deduplication key: "<email-account-email>:<imap-uid>"
  rawEmailId  String?        @unique

  emailAccountId String?
  emailAccount   EmailAccount? @relation(fields: [emailAccountId], references: [id], onDelete: SetNull)

  @@index([platform])
  @@index([account])
  @@index([status])
  @@index([eventDate])
}
