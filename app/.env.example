# ── Database ─────────────────────────────────────────────────────────────────
# Local dev:
#   DATABASE_URL="postgresql://postgres:password@localhost:5432/entradas"
# Neon (recommended for Vercel):
#   DATABASE_URL="postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"
# Supabase:
#   DATABASE_URL="postgresql://postgres:[password]@db.[project].supabase.co:5432/postgres"
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/entradas?sslmode=require"

# ── NextAuth ──────────────────────────────────────────────────────────────────
# LOCAL:      NEXTAUTH_URL="http://localhost:3000"
# PRODUCTION: NEXTAUTH_URL="https://your-app.vercel.app"  ← set to your real Vercel URL
NEXTAUTH_URL="http://localhost:3000"

# Generate a random secret:  openssl rand -base64 32
NEXTAUTH_SECRET="REPLACE_WITH_RANDOM_SECRET"

# ── Admin seed credentials ────────────────────────────────────────────────────
# Used only by: npm run db:seed
# After seeding you can change the password from inside the app.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-in-production"

# ── Google Sheets Integration ─────────────────────────────────────────────────
# The spreadsheet ID from the sheet URL:
#   https://docs.google.com/spreadsheets/d/<SHEET_ID>/edit
GOOGLE_SHEET_ID="your-sheet-id-here"

# Service account credentials (from the downloaded JSON key file):
GOOGLE_SERVICE_ACCOUNT_EMAIL="your-service-account@your-project.iam.gserviceaccount.com"

# Paste the private_key value from the JSON file.
# Keep surrounding quotes. Replace literal newlines with \n.
GOOGLE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----\n"

# ── Vercel Cron protection (optional but recommended) ─────────────────────────
# Set this in Vercel dashboard too. The cron job sends: Authorization: Bearer <secret>
# Generate with:  openssl rand -base64 32
CRON_SECRET="REPLACE_WITH_RANDOM_CRON_SECRET"

# ── IMAP / Email-to-Purchase encryption key ───────────────────────────────────
# Required for storing IMAP passwords encrypted in the database (AES-256-GCM).
# Must be exactly 64 hex characters (= 32 bytes).
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="REPLACE_WITH_64_CHAR_HEX_STRING"
